{
  "name": "scholar-data",
  "private": true,
  "type": "module",
  "version": "1.6.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "pnpm lint:js && pnpm lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm lint:js --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push && prisma generate",
    "prisma:db:pull": "prisma db pull",
    "postinstall": "nuxt prepare && prisma generate",
    "scripts:fill:db": "tsx scripts/fill_db_dataset.ts",
    "scripts:fill:citation": "tsx scripts/fill_db_citation.ts",
    "scripts:truncate:tables": "tsx scripts/truncate-tables.ts",
    "scripts:index:users": "tsx scripts/schedule/create-user-index.ts",
    "scripts:split:ndjson": "tsx scripts/split_nd_json.ts",
    "scripts:generate:sitemaps": "tsx scripts/generate-sitemaps.ts",
    "reset": " rimraf .nuxt && rimraf .output && rimraf dist && rimraf .data && rimraf node_modules && pnpm install",
    "prune-branches": "git removed-branches --prune --force"
  },
